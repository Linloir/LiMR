{
  "name": "@linloir/limr",
  "version": "1.0.0",
  "description": "Linloir's limr Is a Markdown Renderer — extensible reading and streaming components for React",
  "type": "module",
  "license": "MIT",
  "author": "Linloir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linloir/LiMR.git"
  },
  "homepage": "https://linloir.github.io/LiMR/",
  "bugs": {
    "url": "https://github.com/Linloir/LiMR/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs",
    "skills",
    "examples",
    "benchmarks/results/*.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/base.css": "./dist/base.css",
    "./fonts.css": "./dist/fonts/maple.css",
    "./math.css": "./dist/math.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "pnpm pack:skills && vite --host 127.0.0.1",
    "build": "tsup && node scripts/build-assets.mjs",
    "build:playground": "pnpm pack:skills && vite build --base=/LiMR/",
    "preview:playground": "vite preview --host 127.0.0.1 --base=/LiMR/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:package": "node scripts/package-smoke.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "pack:skills": "python3 scripts/package-skills.py",
    "bench": "tsx benchmarks/run.ts",
    "bench:streaming": "tsx benchmarks/streaming.ts",
    "bench:browser": "tsx benchmarks/browser.ts",
    "bench:selection": "tsx benchmarks/selection.ts",
    "bench:markstream": "tsx benchmarks/markstream/run.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "hyphenation.en-us": "^0.2.1",
    "hypher": "^0.2.5",
    "katex": "^0.19.0",
    "linebreak": "^1.1.0",
    "mdast-util-directive": "^3.1.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mermaid": "^12.2.0",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-extension-mdx-jsx": "^3.0.2",
    "micromark-util-decode-string": "^2.0.1",
    "micromark-util-types": "^2.0.3",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@playwright/test": "^1.64.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "markstream-react": "2.0.19",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "stream-diffs": "0.0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
